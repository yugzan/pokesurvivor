# Copia este archivo a .env y rellénalo; luego: docker compose up -d
# Sin .env (o con todo vacío) el juego usa el Firebase y el TURN oficiales.

# Puerto en tu máquina
PORT=8090

# ---- Tu proyecto de Firebase (Consola > Configuración del proyecto > Tus apps > Config) ----
# NUNCA actives Identity Platform en él (cobra por usuario). Ver docs/FIREBASE.md.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_DATABASE_URL=
# Opcionales (por defecto <proyecto>.firebaseapp.com / <proyecto>.firebasestorage.app)
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
# 1 = usar el emulador local de Firebase (127.0.0.1:9099 / 8080 / 9000)
FIREBASE_EMULATOR=
# 1 = sin nube: cada navegador guarda su partida (ignora lo de arriba)
FIREBASE_LOCAL_ONLY=

# Dominios desde los que se permite la nube, separados por comas (localhost ya está)
ALLOWED_HOSTS=

# Worker de Cloudflare para el TURN del cooperativo (docs/TURN.md).
# Con tu propio Firebase, déjalo vacío (sin TURN) o pon tu Worker: el oficial no acepta tus cuentas.
#TURN_URL=
